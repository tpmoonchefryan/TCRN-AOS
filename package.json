{
  "name": "tcrn-aos",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "codegen:migrations": "node scripts/codegen-migrations.mjs",
    "codegen:check": "node scripts/codegen-migrations.mjs --check",
    "build": "pnpm codegen:migrations && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && node dist/apps/server/src/main.js",
    "start": "node dist/apps/server/src/main.js",
    "mcp-stdio": "node dist/packages/mcp/src/stdio.js",
    "test": "node --test --test-concurrency=1 \"packages/**/test/*.test.mjs\" \"apps/**/test/*.test.mjs\"",
    "db:up": "node scripts/dev-db.mjs up",
    "db:down": "node scripts/dev-db.mjs down",
    "migrate": "node dist/scripts/migrate-cli.js",
    "verify": "pnpm typecheck && pnpm codegen:check && pnpm build && pnpm test && pnpm audit:licenses && pnpm gate:manifest && pnpm gate:parity-registry && pnpm gate:no-side-door && pnpm gate:openapi && pnpm gate:mcp-handshake && pnpm gate:forms && pnpm gate:human-only && pnpm gate:search-cjk && pnpm gate:absence && pnpm gate:self-sufficiency && pnpm gate:generated-encoding",
    "verify:fast": "pnpm typecheck && pnpm codegen:check && pnpm build && pnpm test",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "gate:parity-registry": "node scripts/gate-parity-registry.mjs",
    "gate:manifest": "node scripts/gate-manifest.mjs",
    "gate:no-side-door": "node scripts/gate-no-side-door.mjs",
    "gate:openapi": "node scripts/gate-openapi.mjs",
    "gate:mcp-handshake": "node scripts/gate-mcp-handshake.mjs",
    "gate:forms": "node scripts/gate-forms.mjs",
    "gate:human-only": "node scripts/gate-human-only.mjs",
    "gate:search-cjk": "node scripts/gate-search-cjk.mjs",
    "gate:absence": "node scripts/gate-absence.mjs",
    "gate:self-sufficiency": "node scripts/gate-self-sufficiency.mjs",
    "gate:generated-encoding": "node scripts/gate-generated-encoding.mjs",
    "image:build": "node scripts/image-build.mjs",
    "k8s:apply": "node scripts/k8s-apply.mjs",
    "k8s:smoke": "node scripts/k8s-smoke.mjs",
    "k8s:persistence-check": "node scripts/k8s-persistence-check.mjs",
    "verify:deploy": "node scripts/k8s-verify.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sinclair/typebox": "0.34.52",
    "@tcrn/ui-copy-state": "file:vendor/tcrn-ui-copy-state-3.0.0.tgz",
    "@tcrn/ui-react": "file:vendor/tcrn-ui-react-3.0.0.tgz",
    "@tcrn/ui-tokens": "file:vendor/tcrn-ui-tokens-3.0.0.tgz",
    "fastify": "5.12.1",
    "markdown-it": "15.0.0",
    "pg": "8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.0.3",
    "@types/pg": "8.11.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "esbuild": "0.28.1",
    "parse5": "8.0.1",
    "typescript": "5.8.3"
  }
}

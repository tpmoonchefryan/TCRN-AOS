      "truthRootMode": "0700",
      "partitionMode": "0700",
      "workspaceMode": "0700",
      "rationale": "0700 matches the Mac, where .tcrn-workspace/<partition>/workspace/.tcrn-workflow is 0700 and release-trust/gate-identity-authority.json is 0600. The VM has k3s and other services on the same root filesystem, so group- and world-readable chain bytes would widen the read surface for no operational gain.",
      "releaseTrustFileMode": "0600"
    },
    "pairedBackup": {
      "currentPairDestination": "/srv/tcrn/backups",
      "afterRelocation": {
        "localSnapshotDestination": "/srv/tcrn/backups",
        "offHostDestination": "<Owner Mac>:.tcrn-workspace-backups",
        "note": "After relocation the VM holds the chain, so a backup that lives only on the VM proves the machine agrees with itself — the same failure the current arrangement was built to avoid, pointing the other way. The pair's far end must become the Mac (and/or the existing OneDrive cadence), and the far end must be able to answer snapshot-verify / validate / event-list itself. Direction, retention and cadence are unruled; this records the constraint, not the decision."
      }
    }

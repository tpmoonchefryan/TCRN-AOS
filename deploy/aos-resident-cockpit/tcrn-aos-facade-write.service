[Unit]
Description=TCRN AOS facade write service (STORY-182; one ceremony endpoint, loopback only, no pins)
Documentation=file:///srv/tcrn/aos-facade-write/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/srv/tcrn/aos-facade-write/runtime
ExecStart=/usr/local/bin/node /srv/tcrn/aos-facade-write/runtime/deploy/aos-resident-cockpit/facade-write-runner.mjs
# The write facade drives the engine CLI in-process against the governance tree,
# which the relocation ceremony keeps at 0700 root:root — so, like the read face
# and the cockpit, this process must run as root to traverse to the chains it
# writes. It still holds no pins and accepts no authority argument (the source
# gate asserts both at the bytes); the only write path is the one ceremony
# endpoint, and every write is a payload of steps plus a read-back.
User=root
# After the switch window the write facade drives the engine CLI against the
# PG-backed chain as the tcrn_engine role via sudo -u tcrn_engine (PG socket
# peer auth). That is a privilege DECREASE from root, so NoNewPrivileges is
# lifted for this one downward hop — the process never gains a privilege it did
# not already hold.
NoNewPrivileges=no
Environment=FACADE_WRITE_ENGINE=/srv/tcrn/engine/tcrn-workflow
Environment=FACADE_WRITE_HOST=127.0.0.1
Environment=FACADE_WRITE_PORT=4321
Environment=FACADE_WRITE_ROOT=/srv/tcrn/aos-facade-write
Environment=FACADE_WRITE_EVIDENCE=/srv/tcrn/aos-facade-write/evidence
Environment=FACADE_WRITE_WORKSPACES="{\"TCRN-AOS\":\"/srv/tcrn/governance/tcrn-workspace/TCRN-AOS/workspace\",\"Joi-Button\":\"/srv/tcrn/governance/tcrn-workspace/Joi-Button/workspace\",\"cross-project\":\"/srv/tcrn/governance/tcrn-workspace/cross-project/workspace\",\"TCRN-Design-System\":\"/srv/tcrn/governance/tcrn-workspace/TCRN-Design-System/workspace\",\"TCRN-TMS\":\"/srv/tcrn/governance/tcrn-workspace/TCRN-TMS/workspace\"}"
Environment=FACADE_WRITE_ATTEST_DIRS="{\"TCRN-AOS\":\"/srv/tcrn/governance/tcrn-workspace/TCRN-AOS/attestations\",\"Joi-Button\":\"/srv/tcrn/governance/tcrn-workspace/Joi-Button/attestations\",\"cross-project\":\"/srv/tcrn/governance/tcrn-workspace/cross-project/attestations\",\"TCRN-Design-System\":\"/srv/tcrn/governance/tcrn-workspace/TCRN-Design-System/attestations\",\"TCRN-TMS\":\"/srv/tcrn/governance/tcrn-workspace/TCRN-TMS/attestations\"}"
Environment=FACADE_WRITE_ALLOWED_HOSTS=127.0.0.1,localhost
Environment=FACADE_WRITE_ACTOR=agent:fable
Environment=FACADE_PG_SCHEMAS="{\"TCRN-AOS\":\"chain_aos\",\"Joi-Button\":\"chain_joi\",\"cross-project\":\"chain_cross\",\"TCRN-Design-System\":\"chain_ds\",\"TCRN-TMS\":\"chain_tms\"}"
Environment=FACADE_PG_CONNECTION=postgresql:///tcrn_governance?host=/var/run/postgresql
Restart=on-failure
RestartSec=5
ProtectSystem=full
ReadWritePaths=/srv/tcrn
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tcrn-aos-facade-write

[Install]
WantedBy=multi-user.target
